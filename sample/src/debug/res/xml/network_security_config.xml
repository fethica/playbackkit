<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only. Cleartext is allowed for the loopback address the fixture server
    binds, and nowhere else; the release build ships no network security config, so the
    platform default (no cleartext) applies to it unchanged.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
